{
	admin off
	persist_config off
	email {$ACME_EMAIL}
	# Upstream failures can include request metadata in runtime HTTP error logs.
	log {
		exclude http.log.error
	}
	servers {
		protocols h1 h2
		timeouts {
			read_header 5s
			read_body 10s
			write 15s
			idle 30s
		}
		max_header_size 16KB
	}
}
https://{$RELAY_DOMAIN} {
	header Strict-Transport-Security "max-age=86400"
	import proxy.caddy
}

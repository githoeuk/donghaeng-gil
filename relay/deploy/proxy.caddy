# Shared by online and local TLS frontends. Do not add access/body/header logs.
header {
	-Server
	X-Content-Type-Options nosniff
	Cache-Control no-store
}
request_body {
	max_size 16KB
}
@api path /health /v1/*
handle @api {
	reverse_proxy {$RELAY_UPSTREAM:relay:8787} {
		transport http {
			dial_timeout 2s
			response_header_timeout 2s
			read_timeout 3s
			write_timeout 3s
		}
	}
}
handle {
	respond 404
}
